__pycache__/
api_out/
latex_images/
multimodal_input/
venv/
output.txt
# Match .env AND every variant. A bare `.env` does NOT match `.env.bak`, and
# copies of it (.env.bak, .env.bak.<timestamp>) were committed once as a
# result — they held every credential the bot has.
.env*
chroma_db/

# State / runtime data
*.db
*.db-shm
*.db-wal
*.log
bot_state.json
tools/scheduler/tasks.json
tools/scheduler/tasks.json.lock
scheduler_task_logs/

# WSL artifacts
*:Zone.Identifier
# Trusted per-message requester identity (written by PTY path, not committed)
tools/discord/.request_context

# Image service auth token (regenerated per bot start)
tools/images/.image_service

# Clones made by tools/github/* — working copies, not part of this repo
github_workspace/

# Agent task worktrees live inside the target repo, not here — but ignore
# them anyway in case a repo is ever nested under this one.
.worktrees/
